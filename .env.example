# ---------------------------------------------------------------------------
# PestLaunch Call Intelligence
#
# `make env` copies this file to .env and fills in the generated secrets.
# ---------------------------------------------------------------------------

# Public hostname. Caddy obtains a TLS certificate for it automatically.
# "localhost" serves plain local HTTPS with a self-signed certificate.
SITE_DOMAIN=localhost
PUBLIC_BASE_URL=https://localhost

# --- Secrets (generated by `make env`) -------------------------------------
ENCRYPTION_KEY=
JWT_SECRET=
INTERNAL_API_TOKEN=
POSTGRES_PASSWORD=

# --- Call analysis ----------------------------------------------------------
# Recorded calls are classified and scored by Claude.
CLAUDE_API_KEY=
CALL_INTEL_MODEL=claude-sonnet-5
# Independent scoring passes per call; each scorecard item takes the majority.
INTEL_SCORING_RUNS=3
# Recordings processed in parallel.
INTEL_WORKERS=2

# --- Transcription ----------------------------------------------------------
# Default engine for uploads: auto (Deepgram, falling back to local),
# deepgram, or local. Each upload can override it.
CALL_STT_ENGINE=auto
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Local engine model. small.en is noticeably more accurate than base.en on
# phone audio; base.en is faster on small servers.
WHISPER_MODEL=small.en

# --- First admin user (used by `make seed`) --------------------------------
SEED_BUSINESS_NAME="ABC Pest Control"
SEED_ADMIN_EMAIL=admin@pestlaunch.local
SEED_ADMIN_PASSWORD=

# --- Optional: live voice receptionist (`--profile receptionist`) ---------
CALLSENTRY_LOCAL_ONLY=0
WORKER_WITH_TTS=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
PUBLIC_WS_URL=
CLAUDE_MODEL=claude-sonnet-5

LOG_LEVEL=INFO
